# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Standardized on npm (package-lock.json) — keep Bun lockfiles out to avoid drift
bun.lock
bun.lockb

# Environment variables (CRITICAL - never commit!)
.env
.env.local
.env.*.local

# MCP configuration (may contain project-specific settings)
.mcp.json

# Cache directories that should not be watched
.cache
.bun
.vite
.next
.turbo
.parcel-cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Eval run outputs (timestamped JSON + working JSONL)
evals/results/

# TypeScript incremental build info (written by `tsc -b`)
*.tsbuildinfo

# impeccable design-hook caches
.impeccable/

# /brag launch-video compositions: Hyperframes Studio caches, the scaffold's
# generic agent docs, and the bundled third-party music track (restore it
# before re-rendering; see brag-output/README.md)
brag-output*/composition/.thumbnails/
brag-output*/composition/snapshots/
brag-output*/composition/renders/
brag-output*/composition/CLAUDE.md
brag-output*/composition/AGENTS.md
brag-output*/composition/assets/music/*.mp3
