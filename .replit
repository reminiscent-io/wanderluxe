modules = ["bun", "bun-1.2", "nodejs-20", "nodejs-24", "postgresql-16", "web"]
run = "bun run dev"

[nix]
channel = "stable-24_05"
packages = ["supabase-cli", "nodejs_24", "imagemagick"]

[deployment]
run = ["sh", "-c", "bun run start"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "bun run build"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[objectStorage]
defaultBucketID = "replit-objstore-852a1cd5-5447-4cfc-b160-424e3a606d77"

[workflows]
runButton = "Run Development Server"

[[workflows.workflow]]
name = "Run Development Server"
author = 39001524
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run dev"

[agent]
integrations = ["javascript_openai:1.0.0"]
