# WanderLuxe Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Required for: Location autocomplete, accommodation search, restaurant search
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud map style ID for the trip Map view (optional).
# Create at: https://console.cloud.google.com/google/maps-apis/studio/styles
# AdvancedMarker requires a mapId, and setting one makes inline `styles` inert,
# so the warm basemap lives in the Cloud Console. Unset falls back to a demo style.
# VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here

# Gemini API (required for AI Assistant feature)
# Get your API key from: https://aistudio.google.com/app/apikey
# Required for: AI travel assistant chat + travel document OCR
# Model is hardcoded to gemini-2.5-flash in the Edge Function.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (ChatGPT API) — Print Studio design generation (Pro feature)
# Get your API key from: https://platform.openai.com/api-keys
# Required for: POST /api/trips/:id/print-design (the route returns 503 without it)
# Optional OPENAI_MODEL overrides the default model (gpt-4.1)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1

# Supabase Service Role Key (required for server-side operations)
# Get this from: Supabase Dashboard → Settings → API → service_role key (secret)
# WARNING: Keep this secret! Never expose in client-side code
# Required for: AI assistant, PDF export, server-side database operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# STRIPE CONFIGURATION (required for Pro subscriptions)
# =============================================================================

# Stripe Secret Key
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development, live key (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
# Create a webhook endpoint pointing to: https://your-domain/api/stripe/webhook
# Listen for events: checkout.session.completed, customer.subscription.updated,
#                   customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Serper API (optional - for AI restaurant booking link search)
# Get your API key from: https://serper.dev/api-key
# When set, the AI assistant can search the web for Resy/OpenTable booking URLs when recommending restaurants
# When not set, the assistant uses Google Search links as fallback
# Set via: supabase secrets set SERPER_API_KEY=your_key
# SERPER_API_KEY=your_serper_api_key_here

# Unsplash API (optional - for trip imagery)
# Get your access key from: https://unsplash.com/developers
# If not set, the app will use placeholder images
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Admin Email (optional - for special admin permissions)
# Defaults to: kevin@wanderluxe.io
# VITE_ADMIN_EMAIL=admin@yourdomain.com

# Travel Document Parsing (optional - AI document parsing feature)
# If you have a custom endpoint for parsing travel documents
# VITE_PARSE_TRAVEL_DOC_URL=https://your-edge-function-url.supabase.co/functions/v1/parse-travel-doc

# PostHog Analytics (optional - for product analytics)
# Get your project API key from: https://app.posthog.com/settings/project
# VITE_POSTHOG_KEY=phc_your_posthog_key_here
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Place Photo Cache TTL (optional - in milliseconds)
# How long to cache Google Places photos
# Default: 3600000 (1 hour)
# VITE_PLACE_PHOTO_CACHE_TTL_MS=3600000

# MCP server public base URL (optional - advertised in OAuth discovery metadata)
# MCP_PUBLIC_BASE_URL=https://wanderluxe.io

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# =============================================================================
# These are read by Edge Functions (Deno), NOT by the Express server or Vite.
# Set them per function environment with: supabase secrets set KEY=value
#
# GOOGLE_PLACES_API_KEY=...      # google-places-proxy + timezone-proxy
# OPENWEATHERMAP_API_KEY=...     # weather-proxy (current + 5-day forecasts)
# AERODATABOX_API_KEY=...        # flight-status-proxy (RapidAPI; free tier: 600 calls/mo)
# SENDGRID_API_KEY=...           # send-email / send-share-notification (share emails)
# MAILGUN_API_KEY=...            # send-trip-reminders (reminder emails)
# MAILGUN_DOMAIN=mail.wanderluxe.io
# EXCHANGE_RATE_API=...          # update-exchange-rates (exchangerate-api.com)
# CRON_SECRET=...                # auth for scheduled functions (reminders, exchange rates)
# ALLOWED_ORIGIN=https://wanderluxe.io   # CORS origin for Edge Functions

# =============================================================================
# REPLIT DEPLOYMENT NOTES
# =============================================================================
# When deploying to Replit:
# 1. Do NOT edit the .env file with actual values
# 2. Instead, use the Replit Secrets feature:
#    - Click "Tools" → "Secrets"
#    - Add each variable name and value
#    - Replit will inject them at runtime
# 3. The .env file can remain empty or have placeholder values
#
# Required Replit Secrets:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_ANON_KEY
#   - VITE_GOOGLE_MAPS_API_KEY
#   - GEMINI_API_KEY (for AI assistant + travel doc OCR)
#   - SUPABASE_SERVICE_ROLE_KEY (for server-side operations)
#   - STRIPE_SECRET_KEY (for Pro subscriptions)
#   - STRIPE_WEBHOOK_SECRET (for payment webhooks)
#   - OPENAI_API_KEY (for the Print Studio Pro feature)
#
# Optional Replit Secrets:
#   - SERPER_API_KEY (for restaurant booking link search)
#   - VITE_UNSPLASH_ACCESS_KEY
# =============================================================================

# Eval harness (npm run evals) — dedicated eval user in the prod Supabase project
EVAL_USER_EMAIL=evals@wanderluxe.io
EVAL_USER_PASSWORD=choose_a_long_random_password

# =============================================================================
# LOCAL DEVELOPMENT NOTES
# =============================================================================
# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git (it's in .gitignore)
# 4. Restart your dev server: npm run dev
# =============================================================================
