# WanderLuxe Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Required for: Location autocomplete, accommodation search, restaurant search
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAI API (required for AI Assistant feature)
# Get your API key from: https://platform.openai.com/api-keys
# Required for: AI travel assistant chat functionality
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Service Role Key (required for server-side operations)
# Get this from: Supabase Dashboard → Settings → API → service_role key (secret)
# WARNING: Keep this secret! Never expose in client-side code
# Required for: AI assistant, PDF export, server-side database operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# OpenAI Model (optional - for AI assistant)
# Default: gpt-4o-mini
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Unsplash API (optional - for trip imagery)
# Get your access key from: https://unsplash.com/developers
# If not set, the app will use placeholder images
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Admin Email (optional - for special admin permissions)
# Defaults to: kevin@wanderluxe.io
# VITE_ADMIN_EMAIL=admin@yourdomain.com

# Travel Document Parsing (optional - AI document parsing feature)
# If you have a custom endpoint for parsing travel documents
# VITE_PARSE_TRAVEL_DOC_URL=https://your-edge-function-url.supabase.co/functions/v1/parse-travel-doc

# Place Photo Cache TTL (optional - in milliseconds)
# How long to cache Google Places photos
# Default: 3600000 (1 hour)
# VITE_PLACE_PHOTO_CACHE_TTL_MS=3600000

# =============================================================================
# REPLIT DEPLOYMENT NOTES
# =============================================================================
# When deploying to Replit:
# 1. Do NOT edit the .env file with actual values
# 2. Instead, use the Replit Secrets feature:
#    - Click "Tools" → "Secrets"
#    - Add each variable name and value
#    - Replit will inject them at runtime
# 3. The .env file can remain empty or have placeholder values
#
# Required Replit Secrets:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_ANON_KEY
#   - VITE_GOOGLE_MAPS_API_KEY
#   - OPENAI_API_KEY (for AI assistant)
#   - SUPABASE_SERVICE_ROLE_KEY (for server-side operations)
#
# Optional Replit Secrets:
#   - OPENAI_CHAT_MODEL (defaults to gpt-4o-mini)
#   - VITE_UNSPLASH_ACCESS_KEY
# =============================================================================

# =============================================================================
# LOCAL DEVELOPMENT NOTES
# =============================================================================
# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git (it's in .gitignore)
# 4. Restart your dev server: bun run dev
# =============================================================================
