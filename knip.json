{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "scripts/*.{ts,mjs}",
    "evals/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "server/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js}",
    "server/**/*.{ts,js}",
    "scripts/**/*.{ts,mjs}",
    "evals/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/integrations/supabase/types/**"
  ],
  "ignoreDependencies": [
    "@types/google.maps",
    "tar-fs"
  ]
}
